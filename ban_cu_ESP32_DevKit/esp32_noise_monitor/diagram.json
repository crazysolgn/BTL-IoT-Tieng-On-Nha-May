{
  "version": 1,
  "author": "IoT Noise Monitor",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": -110, "left": -160, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": -115, "left": 200, "attrs": { "temperature": "30", "humidity": "65" } },
    { "type": "wokwi-led", "id": "ledG", "top": 40, "left": 260, "attrs": { "color": "green" } },
    { "type": "wokwi-led", "id": "ledY", "top": 40, "left": 300, "attrs": { "color": "yellow" } },
    { "type": "wokwi-led", "id": "ledR", "top": 40, "left": 340, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 140, "left": 250, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 140, "left": 290, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r3", "top": 140, "left": 330, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "bz1", "top": 40, "left": 400, "attrs": { "volume": "0.1" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "pot1:VCC", "esp:3V3", "red", [] ],
    [ "pot1:GND", "esp:GND.1", "black", [] ],
    [ "pot1:SIG", "esp:34", "orange", [] ],
    [ "dht1:VCC", "esp:3V3", "red", [] ],
    [ "dht1:GND", "esp:GND.2", "black", [] ],
    [ "dht1:SDA", "esp:15", "green", [] ],
    [ "esp:25", "r1:1", "green", [] ],
    [ "r1:2", "ledG:A", "green", [] ],
    [ "ledG:C", "esp:GND.2", "black", [] ],
    [ "esp:26", "r2:1", "gold", [] ],
    [ "r2:2", "ledY:A", "gold", [] ],
    [ "ledY:C", "esp:GND.2", "black", [] ],
    [ "esp:27", "r3:1", "red", [] ],
    [ "r3:2", "ledR:A", "red", [] ],
    [ "ledR:C", "esp:GND.2", "black", [] ],
    [ "esp:14", "bz1:2", "purple", [] ],
    [ "bz1:1", "esp:GND.2", "black", [] ]
  ],
  "dependencies": {}
}
